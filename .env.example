# ---------- SHAMBA Tracker environment ----------
# Copy to .env for local dev, or set these in Railway > Variables.

# Flask
SECRET_KEY=change-this-to-a-long-random-string
# PUBLIC_BASE_URL is used to build the shareable report links inside messages.
# On Railway, set it to your app's public URL, e.g. https://shamba-tracker.up.railway.app
PUBLIC_BASE_URL=

# First admin (seeded on first run only, if no users exist)
ADMIN_NAME=Cathy
ADMIN_EMAIL=cathy@acre-insights.com
ADMIN_PASSWORD=AcreInsights2026

# ---------- Email (set ONE provider's key) ----------
# Resend -> https://resend.com  (create an API key under "API Keys")
RESEND_API_KEY=
# or SendGrid -> https://sendgrid.com
SENDGRID_API_KEY=
#
# MAIL_FROM is the sender address.
#   * Resend: to send from your own domain you must VERIFY that domain at
#     https://resend.com/domains first, otherwise Resend returns 403.
#     For quick testing, leave MAIL_FROM blank (or set it to onboarding@resend.dev)
#     and Resend will deliver to the email address that owns the Resend account.
#   * SendGrid: the from address must be a Verified Sender.
MAIL_FROM=

# ---------- WhatsApp (set ONE provider's keys) ----------
# Twilio -> https://www.twilio.com/whatsapp
#   Copy the Account SID and Auth Token EXACTLY from the Twilio Console (no extra
#   spaces) or Twilio returns 401. For the sandbox, TWILIO_WHATSAPP_FROM is the
#   Twilio sandbox number and each recipient must first join the sandbox by
#   sending the given "join <code>" message.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886
# or Meta WhatsApp Cloud API -> https://developers.facebook.com/docs/whatsapp
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=

# ---------- Database (optional) ----------
# Defaults to local SQLite file. To use Postgres on Railway, set e.g.
# DATABASE_URL=postgresql://user:pass@host:5432/dbname
DATABASE_URL=

# ---- Hand-off share links -------------------------------------------------
# Used to turn a locally-typed phone number into the international form that
# wa.me needs: a leading 0 is replaced with this code. 254 = Kenya.
DEFAULT_COUNTRY_CODE=254

# ---- Public links ---------------------------------------------------------
# The base used inside farmer report links. Set this to your real domain when
# running behind a proxy or a custom domain, otherwise the request host is used.
PUBLIC_BASE_URL=https://shamba-tracker.winebald.tech
